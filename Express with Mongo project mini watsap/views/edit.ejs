<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Chat - Mini WhatsApp</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: radial-gradient(circle at top left, #0d1117, #1a1f24, #000);
      color: #e4e4e4;
      font-family: "Poppins", sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 30px;
    }

    .form-card {
      background: linear-gradient(145deg, #1b1b1b, #252525);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
      border-radius: 25px;
      padding: 35px;
      width: 100%;
      max-width: 500px;
      text-align: center;
      animation: fadeInUp 0.6s ease;
    }

    h1 {
      color: #25d366;
      font-weight: 600;
      margin-bottom: 25px;
    }

    label {
      display: block;
      text-align: left;
      margin: 10px 0 5px;
      color: #bbb;
      font-size: 0.9rem;
    }

    input, textarea {
      width: 100%;
      padding: 12px 15px;
      border-radius: 12px;
      border: none;
      outline: none;
      margin-bottom: 20px;
      background: #161b20;
      color: #fff;
      font-size: 0.95rem;
      transition: all 0.3s ease;
      box-shadow: inset 0 0 5px rgba(0, 255, 150, 0.3);
    }

    input:focus, textarea:focus {
      box-shadow: 0 0 15px rgba(37, 211, 102, 0.6);
      transform: scale(1.02);
    }

    textarea {
      resize: none;
      height: 100px;
    }

    .submit-btn {
      background: linear-gradient(135deg, #25d366, #128c7e);
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 40px;
      padding: 12px 30px;
      width: 100%;
      font-size: 1rem;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
      box-shadow: 0 0 20px rgba(37, 211, 102, 0.4);
    }

    .submit-btn:hover {
      background: linear-gradient(135deg, #00ff9d, #00b36b);
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 0 25px rgba(0, 255, 150, 0.7);
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    footer {
      margin-top: 40px;
      color: #777;
      font-size: 0.85rem;
    }
  </style>
</head>

<body>
  <div class="form-card">
    <h1><i class="fa-solid fa-pen-to-square"></i> Edit Chat</h1>

    <form action="/chats/<%= chat._id %>?_method=PUT" method="post">
      <label for="from">Sender Name</label>
      <input type="text" name="from" id="from" value="<%= chat.from %>" required />

      <label for="msg">Message</label>
      <textarea name="msg" id="msg" required><%= chat.msg %></textarea>

      <label for="to">Receiver Name</label>
      <input type="text" name="to" id="to" value="<%= chat.to %>" required />

      <button type="submit" class="submit-btn">
        <i class="fa-solid fa-pen-to-square"></i> Update Chat
      </button>
    </form>
  </div>

  <footer>💬 Designed by <strong>Saifullah Khalid</strong> | Mini WhatsApp Project</footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
