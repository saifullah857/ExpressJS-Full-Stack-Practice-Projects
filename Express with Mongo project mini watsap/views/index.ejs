<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mini WhatsApp - Chat List</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <!-- Lordicon for animated 3D icons -->
  <script src="https://cdn.lordicon.com/lordicon.js"></script>

  <style>
    body {
      background: radial-gradient(circle at top left, #0d1117, #1a1f24, #000);
      color: #e4e4e4;
      font-family: "Poppins", sans-serif;
      min-height: 100vh;
    }

    /* 🌟 Navbar */
    .navbar {
      background: #121212;
      box-shadow: 0 0 25px rgba(0, 0, 0, 0.6);
      padding: 0.8rem 1rem;
    }

    .navbar-brand {
      color: #25D366 !important;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .navbar-nav .nav-link {
      color: #e4e4e4 !important;
      font-weight: 500;
      transition: color 0.3s ease;
      margin-left: 15px;
    }

    .navbar-nav .nav-link:hover {
      color: #25D366 !important;
      text-shadow: 0 0 10px rgba(37, 211, 102, 0.7);
    }

    /* 🌟 New Chat Button */
    .new-chat-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, #00c46a, #007d3a);
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 50px;
      padding: 12px 25px;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 0 15px rgba(37, 211, 102, 0.5);
      transition: all 0.3s ease;
      margin-bottom: 25px;
    }

    .new-chat-btn:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 0 25px rgba(0, 255, 150, 0.7);
      background: linear-gradient(135deg, #00ff88, #00b45e);
    }

    /* 💬 Chat Cards */
    .chat-card {
      background: linear-gradient(145deg, #1b1b1b, #252525);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
      padding: 20px;
      margin-bottom: 18px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      animation: fadeInUp 0.5s ease forwards;
    }

    .chat-card:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 15px 30px rgba(0,255,150,0.2);
    }

    .chat-header {
      display: flex;
      align-items: center;
      margin-bottom: 12px;
      gap: 10px;
    }

    .chat-header h5 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: #25D366;
    }

    .chat-msg {
      font-size: 0.95rem;
      color: #ddd;
      margin: 10px 0;
    }

    .chat-time {
      font-size: 0.8rem;
      color: #aaa;
    }

    /* ✨ Buttons */
    .edit-btn, .delete-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      border: none;
      border-radius: 40px;
      padding: 8px 22px;
      font-size: 0.95rem;
      letter-spacing: 0.3px;
      transition: all 0.3s ease;
      cursor: pointer;
      margin: 5px;
    }

    .edit-btn {
      background: linear-gradient(135deg, #25d366, #128c7e);
      color: #fff;
      box-shadow: 0 0 12px rgba(37, 211, 102, 0.4);
    }

    .edit-btn:hover {
      transform: translateY(-3px) scale(1.05);
      background: linear-gradient(135deg, #00ff9d, #00b36b);
      box-shadow: 0 0 25px rgba(0,255,150,0.7);
    }

    .delete-btn {
      background: linear-gradient(135deg, #ff4747, #b30000);
      color: #fff;
      box-shadow: 0 0 12px rgba(255, 80, 80, 0.4);
    }

    .delete-btn:hover {
      transform: translateY(-3px) scale(1.05);
      background: linear-gradient(135deg, #ff5c5c, #ff0000);
      box-shadow: 0 0 25px rgba(255, 0, 0, 0.7);
    }

    .delete-btn i {
      transition: transform 0.4s ease;
    }

    .delete-btn:hover i {
      transform: rotate(15deg) scale(1.2);
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>
  <!-- 🌐 Navbar -->
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="#">
        <i class="fa-brands fa-whatsapp"></i> Mini WhatsApp
      </a>
      <button class="navbar-toggler text-white border-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <i class="fa-solid fa-bars"></i>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item"><a href="/chats" class="nav-link"><i class="fa-solid fa-comments"></i> Chats</a></li>
          <li class="nav-item"><a href="/chats/new" class="nav-link"><i class="fa-solid fa-plus"></i> New Chat</a></li>
          <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-user"></i> Profile</a></li>
          <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-circle-info"></i> About</a></li>
          <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-phone"></i> Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- 💬 Chat Container -->
  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-8 text-center">
        <form action="/chats/new" method="get" class="mb-4">
          <button type="submit" class="new-chat-btn">
            <i class="fa-solid fa-plus"></i> New Chat
          </button>
        </form>

        <% chats.forEach((chat) => { %>
          <div class="chat-card">
            <div class="chat-header">
              <lord-icon
                src="https://cdn.lordicon.com/dxjqoygy.json"
                trigger="loop"
                colors="primary:#25d366,secondary:#00ffff"
                style="width:45px;height:45px">
              </lord-icon>
              <h5><%= chat.from %> ➜ <%= chat.to %></h5>
            </div>

            <p class="chat-msg"><i class="fa-solid fa-message"></i> <%= chat.msg %></p>

            <div class="chat-time mb-3">
              <i class="fa-regular fa-clock"></i> <%= chat.created_at.toLocaleString() %>
            </div>

            <form action="/chats/<%=chat._id %>/edit" method="get" style="display:inline;">
              <button class="edit-btn"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
            </form>
            <form action="/chats/<%= chat._id %>" method="get">
              <button>show chat</button>
            </form>

            <form action="/chats/<%=chat._id %>?_method=DELETE" method="post" style="display:inline;">
              <button class="delete-btn"><i class="fa-solid fa-trash"></i> Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <footer class="text-center text-secondary py-3">
    <small>💬 Designed by <strong>Saifullah Khalid</strong> | Mini WhatsApp Project</small>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
