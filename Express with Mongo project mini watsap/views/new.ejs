<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create New Chat | Mini WhatsApp</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <!-- Lordicon for animated 3D icons -->
  <script src="https://cdn.lordicon.com/lordicon.js"></script>

  <style>
    body {
      background: radial-gradient(circle at top left, #0d1117, #1a1f24, #000);
      color: #e4e4e4;
      font-family: "Poppins", sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .chat-form-container {
      background: rgba(30, 30, 30, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      border-radius: 20px;
      padding: 40px;
      width: 100%;
      max-width: 450px;
      animation: fadeInUp 0.6s ease forwards;
      backdrop-filter: blur(8px);
    }

    h1 {
      text-align: center;
      color: #25d366;
      font-weight: 600;
      margin-bottom: 25px;
    }

    .form-control {
      background-color: #1a1f24;
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #e4e4e4;
      border-radius: 12px;
      padding: 12px;
    }

    .form-control::placeholder {
      color: #888;
    }

    .form-control:focus {
      border-color: #25d366;
      box-shadow: 0 0 8px rgba(37, 211, 102, 0.4);
    }

    .btn-send {
      background: linear-gradient(135deg, #00c46a, #007d3a);
      border: none;
      color: #fff;
      font-weight: 600;
      border-radius: 50px;
      padding: 12px 25px;
      width: 100%;
      letter-spacing: 0.5px;
      box-shadow: 0 0 15px rgba(37, 211, 102, 0.5);
      transition: all 0.3s ease;
      margin-top: 15px;
    }

    .btn-send:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 25px rgba(0, 255, 150, 0.7);
      background: linear-gradient(135deg, #00ff88, #00b45e);
    }

    .lordicon {
      display: block;
      margin: 0 auto 15px auto;
      width: 80px;
      height: 80px;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(25px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .back-btn {
      text-decoration: none;
      color: #25d366;
      display: inline-flex;
      align-items: center;
      margin-top: 15px;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .back-btn:hover {
      color: #00ff88;
    }
  </style>
</head>
<body>

  <div class="chat-form-container">
    <lord-icon
      src="https://cdn.lordicon.com/ayhtotha.json"
      trigger="loop"
      colors="primary:#25d366,secondary:#00ffff"
      class="lordicon">
    </lord-icon>

    <h1>Start a New Chat</h1>

    <form action="/chats" method="post">
      <div class="mb-3">
        <input type="text" name="from" class="form-control" placeholder="👤 Sender name"  />
      </div>

      <div class="mb-3">
        <textarea name="msg" rows="3" class="form-control" placeholder="💬 Type your message..." ></textarea>
      </div>

      <div class="mb-3">
        <input type="text" name="to" class="form-control" placeholder="📨 Receiver name"  />
      </div>

      <button type="submit" class="btn-send">
        <i class="fa-solid fa-paper-plane"></i> Send Chat
      </button>

      <div class="text-center">
        <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Chats</a>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
