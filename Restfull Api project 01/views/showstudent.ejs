<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Details - <%= singleStudent.name %>
    </title>

    <!-- Bootstrap 5 CSS for structure and utilities -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Font (Inter is the default for a modern, clean look) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        /* Define theme colors based on index.ejs */
        :root {
            --body-bg-start: #E3D6C8;
            /* Beige */
            --body-bg-end: #EAC755;
            /* Gold */
            --card-bg: #0f172a;
            /* Dark Slate Blue */
            --light-text: #f1f5f9;
            /* Light Off-White */
            --dark-text: #0f172a;
            /* Dark Text on accents */
            --action-blue: #2563eb;
            /* Primary action blue */
        }

        /* Apply the gradient background and light text color */
        body {
            background: linear-gradient(90deg, var(--body-bg-start), var(--body-bg-end));
            /* Match index.ejs body background */
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Inter', sans-serif;
            color: var(--light-text);
            /* Light text on the dark card */
            padding: 20px;
        }

        /* Dark Card Styling */
        .profile-card {
            background-color: var(--card-bg);
            /* Match index.ejs card color */
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            /* Stronger shadow for dark card */
            max-width: 400px;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            /* Subtle light border */
            /* Subtle entry animation */
            animation: fadeIn 0.5s ease-out forwards;
        }

        /* Image Styling */
        .profile-img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid var(--body-bg-end);
            /* Gold accent border */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            margin-top: -60px;
            /* Pulls image up */
            transition: transform 0.3s ease;
        }

        .profile-img:hover {
            transform: scale(1.05);
        }

        .profile-img-container {
            text-align: center;
        }

        /* Department Tag (using gradient from index.ejs) */
        .department-tag {
            background: linear-gradient(90deg, var(--body-bg-start), var(--body-bg-end));
            color: var(--dark-text);
            /* Dark text on gold/beige accent */
            padding: 5px 12px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-block;
            margin-bottom: 20px;
            box-shadow: 0 2px 5px rgba(234, 199, 85, 0.4);
        }

        /* Details List */
        .detail-item {
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            /* Light separator for dark card */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .detail-item:last-child {
            border-bottom: none;
        }

        .detail-label {
            font-weight: 400;
            color: var(--body-bg-end);
            /* Gold color for labels */
            font-size: 0.95rem;
        }

        .detail-value {
            font-weight: 600;
            color: var(--light-text);
            /* Light text color for values */
            font-size: 1rem;
        }

        /* Back Button (using action blue from index.ejs) */
        .btn-custom-back {
            padding: 15px 25px;
            background: linear-gradient(90deg, #e3d6c8, #eac755);
            color: #0f172a;
            border-radius: 15px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 2px 3px 4px black;
        }

        .btn-custom-back:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px black;
             color: #0f172a;
        }

        /* Keyframe Animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>
    <div class="profile-card">

        <!-- Top Section for Image Placement (Dark background for context) -->
        <div class="bg-dark p-5 pt-0 rounded-top-4">
            <h1 class="h5 pt-3 fw-bold text-center text-white-50">Student Profile</h1>
        </div>

        <!-- Image and Name -->
        <div class="profile-img-container mb-4 px-4">
            <img src="<%= singleStudent.image %>" alt="<%= singleStudent.name %> Profile" class="profile-img"
                onerror="this.onerror=null; this.src='https://placehold.co/120x120/0f172a/EAC755?text=S';">
            <h2 class="h4 mt-3 mb-1 fw-bold text-light">
                <%= singleStudent.name %>
            </h2>
            <p class="text-white-50 small">ID: <%= singleStudent.id %>
            </p>
            <span class="department-tag">
                <%= singleStudent.department %>
            </span>
        </div>

        <!-- Student Details List -->
        <div class="student-details px-4 pb-4">

            <div class="detail-list">

                <!-- Semester Detail -->
                <div class="detail-item">
                    <span class="detail-label">Current Semester</span>
                    <span class="detail-value">
                        <%= singleStudent.semester %>
                    </span>
                </div>

                <!-- CGPA Detail -->
                <div class="detail-item">
                    <span class="detail-label">CGPA</span>
                    <!-- text-warning is used here as a standard Bootstrap color closest to gold/yellow -->
                    <span class="detail-value text-warning">
                        <%= singleStudent.cgpa %>
                    </span>
                </div>
            </div>

            <!-- Action Button (Back link) -->
            <div class="d-grid mt-4 pt-2">
                <a href="/students" class="btn btn-lg rounded-pill btn-custom-back">
                    ← Back to List
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>