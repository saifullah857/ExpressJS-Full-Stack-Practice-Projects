<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student Data - <%= singleStudent.name %></title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Google Font (Inter for professionalism) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        /* Define theme colors based on index.ejs */
        :root {
            --body-bg-start: #E3D6C8; /* Beige */
            --body-bg-end: #EAC755;   /* Gold */
            --card-bg: #0f172a;       /* Dark Slate Blue */
            --light-text: #f1f5f9;    /* Light Off-White */
            --dark-text: #0f172a;     /* Dark Text on accents */
            --action-blue: #2563eb;   /* Primary action blue (Save) */
            --gold-accent: #EAC755;   /* Gold accent */
        }
        
        /* Apply the gradient background and light text color */
        body {
            background: linear-gradient(90deg, var(--body-bg-start), var(--body-bg-end));
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Inter', sans-serif;
            color: var(--light-text);
            padding: 20px;
        }
        
        /* Dark Form Card Styling */
        .form-card {
            background-color: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            max-width: 500px;
            width: 100%;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            animation: fadeIn 0.5s ease-out forwards; 
        }

        /* Form Control Overrides (Dark theme) */
        .form-control, .form-select {
            background-color: #1f2937; /* Slightly lighter dark input field */
            color: var(--light-text);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            background-color: #1f2937;
            color: var(--light-text);
            box-shadow: 0 0 0 0.25rem rgba(234, 199, 85, 0.5); /* Gold focus ring */
            border-color: var(--gold-accent);
        }

        /* Labels */
        label {
            font-weight: 600;
            color: var(--gold-accent); /* Gold color for labels */
            margin-bottom: 5px;
            display: block;
        }

        /* Image Preview (Optional but helpful) */
        .current-image-preview {
            max-width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid var(--gold-accent);
            margin-top: 10px;
            display: block;
        }

        /* Submit Button (Matching action blue) */
        .btn-custom-submit {
            background-color: var(--action-blue);
            border-color: var(--action-blue);
            color: #fff;
            font-weight: 600;
            padding: 12px 25px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .btn-custom-submit:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.5);
        }

        .btn-back {
            color: var(--light-text);
            text-decoration: none;
            font-size: 0.9rem;
            opacity: 0.8;
            transition: opacity 0.2s;
        }
        .btn-back:hover {
            opacity: 1;
            color: var(--gold-accent);
        }

        /* Keyframe Animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="form-card">
        <h2 class="text-center fw-bold mb-4" style="color: var(--gold-accent);">
            Edit Student: <%= singleStudent.name %>
        </h2>

        <form 
            action="/students/<%= singleStudent.id %>?_method=PATCH" 
            method="post" 
            enctype="multipart/form-data"
        >
            <!-- Name Input -->
            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input 
                    type="text" 
                    name="name" 
                    class="form-control" 
                    id="name" 
                    value="<%= singleStudent.name %>" 
                    required
                >
            </div>

            <!-- CGPA Input -->
            <div class="mb-3">
                <label for="cgpa" class="form-label">CGPA</label>
                <input 
                    type="number" 
                    name="cgpa" 
                    class="form-control" 
                    id="cgpa" 
                    step="0.01" 
                    min="0.0" 
                    max="4.0" 
                    value="<%= singleStudent.cgpa %>" 
                    required
                >
            </div>

            <!-- Semester Input -->
            <div class="mb-3">
                <label for="semester" class="form-label">Semester</label>
                <input 
                    type="text" 
                    name="semester" 
                    class="form-control" 
                    id="semester" 
                    value="<%= singleStudent.semester %>" 
                    required
                >
            </div>

            <!-- Department Input -->
            <div class="mb-3">
                <label for="department" class="form-label">Department</label>
                <!-- NOTE: The name attribute must be 'department', not 'name' -->
                <input 
                    type="text" 
                    name="department" 
                    class="form-control" 
                    id="department" 
                    value="<%= singleStudent.department %>" 
                    required
                >
            </div>

            <!-- Image Input (Explicitly showing current and new options) -->
            <div class="mb-4">
                <label class="form-label">Current Image</label>
                <!-- Display the current image -->
                <img 
                    src="<%= singleStudent.image %>" 
                    alt="Current Profile Image" 
                    class="current-image-preview mb-2"
                    onerror="this.style.display='none';"
                >
                
                <label for="image" class="form-label mt-3">Upload a New Image</label>
                <!-- Input field for the new image (optional) -->
                <input 
                    type="file" 
                    name="image" 
                    class="form-control" 
                    id="image" 
                >
                <small class="text-white-50 mt-1 d-block">
                    Leave this field blank to retain the image shown above.
                </small>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-lg btn-custom-submit">
                    Save Changes
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a href="/students/<%= singleStudent.id %>" class="btn-back">
                Cancel and Go Back
            </a>
        </div>
    </div>
    
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
