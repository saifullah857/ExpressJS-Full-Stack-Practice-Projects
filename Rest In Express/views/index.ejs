<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Posts</title>

  <!-- ✅ Bootstrap 5 CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    body {
      background: linear-gradient(135deg, #74b9ff, #a29bfe);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      padding-top: 50px;
    }

    h1 {
      text-align: center;
      margin-bottom: 40px;
      color: #2d3436;
      font-weight: 700;
      animation: fadeIn 1s ease-in-out;
      letter-spacing: 1px;
    }

    .card {
      border: none;
      border-radius: 18px;
      box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      background: #fff;
      overflow: hidden;
      position: relative;
    }

    .card:hover {
      transform: translateY(-7px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
    }

    .username {
      color: #6c5ce7;
      font-weight: 600;
      margin-bottom: 8px;
      font-size: 1.1rem;
    }

    .content {
      color: #2d3436;
      font-size: 1rem;
      line-height: 1.5;
    }

    .btn-detail {
      display: inline-block;
      margin-top: 15px;
      background: #6c5ce7;
      color: #fff;
      border: none;
      padding: 8px ;
      border-radius: 25px;
      font-size: 0.9rem;
      transition: 0.3s ease;
      text-decoration: none;
      text-align: center;
      width: auto;
    }

    .btn-detail:hover {
      background: #4834d4;
      transform: scale(1.05);
      color: #fff;
    }

    .btn-custom {
      display: block;
      width: fit-content;
      margin: 50px auto 0;
      text-decoration: none;
      padding: 12px 24px;
      background: #00cec9;
      color: white;
      border-radius: 30px;
      font-weight: 500;
      transition: 0.3s ease;
      box-shadow: 0 5px 10px rgba(0, 0, 0, 0.15);
    }

    .btn-custom:hover {
      background: #00b894;
      transform: scale(1.07);
      color: #fff;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <div class="container">
    <h1> Quora Posts</h1>

    <div class="row g-4">
      <% for (const post of posts) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card p-4 h-100">
            <h4 class="username">@ <%= post.username %></h4>
            <p class="content"><%= post.content %></p>
            <a href="http://localhost:8080/posts/<%= post.id %>" class="btn-detail">See in Detail</a>
            <a href="http://localhost:8080/posts/<%= post.id %>/edit" class="btn-detail">Edit Post</a>
          </div>
        </div>
      <% } %>
    </div>

    <a href="http://localhost:8080/Posts/new" class="btn-custom">➕ Create New Post</a>
  </div>

  <!-- ✅ Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
