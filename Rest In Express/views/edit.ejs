<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Post</title>

  <!-- ✅ Bootstrap 5 CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    body {
      background: linear-gradient(135deg, #74b9ff, #a29bfe);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .edit-container {
      background: #fff;
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      max-width: 600px;
      width: 100%;
      animation: fadeIn 0.8s ease;
    }

    h2 {
      text-align: center;
      color: #2d3436;
      margin-bottom: 25px;
      font-weight: 700;
    }

    label {
      font-weight: 600;
      color: #6c5ce7;
      margin-bottom: 8px;
      display: block;
    }

    textarea {
      width: 100%;
      border-radius: 10px;
      border: 1px solid #ccc;
      padding: 12px;
      resize: none;
      font-size: 1rem;
      transition: 0.3s ease;
    }

    textarea:focus {
      border-color: #6c5ce7;
      box-shadow: 0 0 8px rgba(108, 92, 231, 0.3);
      outline: none;
    }

    .btn-submit {
      display: block;
      width: 100%;
      background: #6c5ce7;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-size: 1rem;
      font-weight: 500;
      transition: 0.3s ease;
      margin-top: 20px;
    }

    .btn-submit:hover {
      background: #4834d4;
      transform: scale(1.03);
    }

    .back-link {
      text-decoration: none;
      display: block;
      text-align: center;
      margin-top: 15px;
      color: #00cec9;
      font-weight: 500;
      transition: 0.3s ease;
    }

    .back-link:hover {
      color: #009b8e;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>
  <div class="edit-container">
    <h2>✏️ Edit Your Post</h2>

    <p><strong>Post ID:</strong> <%= post.id %></p>
    <p><strong>Username:</strong> @<%= post.username %></p>

    <!-- ✅ Proper POST route with method override -->
    <form action="http://localhost:8080/posts/<%= post.id %>?_method=PATCH" method="POST">
      <label for="content">Edit Content:</label>
      <textarea id="content" name="content" rows="6" required><%= post.content %></textarea>
      <button type="submit" class="btn-submit">💾 Save Changes</button>
    </form>

  </div>

  <!-- ✅ Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
