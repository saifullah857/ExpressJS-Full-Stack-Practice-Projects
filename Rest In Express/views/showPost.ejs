<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Show Post in Detail</title>

  <!-- ✅ Bootstrap 5 CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    body {
      background: linear-gradient(135deg, #74b9ff, #a29bfe);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      padding: 40px;
      max-width: 600px;
      width: 100%;
      text-align: center;
      animation: fadeIn 0.8s ease-in-out;
    }

    h1 {
      color: #2d3436;
      font-weight: 700;
      margin-bottom: 30px;
      animation: slideDown 0.7s ease;
    }

    .post-id {
      color: #636e72;
      font-size: 0.9rem;
      margin-bottom: 10px;
    }

    .username {
      color: #6c5ce7;
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 15px;
    }

    .content {
      color: #2d3436;
      font-size: 1.1rem;
      background: #f1f2f6;
      border-radius: 12px;
      padding: 20px;
      text-align: left;
      line-height: 1.5;
    }

    .btn-back {
      display: inline-block;
      margin-top: 30px;
      text-decoration: none;
      padding: 10px 25px;
      background: #6c5ce7;
      color: white;
      border-radius: 25px;
      transition: 0.3s;
      font-weight: 500;
    }

    .btn-back:hover {
      background: #4834d4;
      transform: scale(1.05);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-15px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>
  <div class="card">
    <h1>📝 Post in Detail</h1>
    <p class="post-id">Post ID: <%= post.id %></p>
    <h3 class="username">@ <%= post.username %></h3>
    <p class="content"><%= post.content %></p>

    <a href="http://localhost:8080/posts" class="btn-back">⬅ Back to All Posts</a>
  </div>

  <!-- ✅ Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
