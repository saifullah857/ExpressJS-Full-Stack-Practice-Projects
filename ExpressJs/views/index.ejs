<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Page</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
    }

    nav {
      background-color: rgba(255, 243, 225, 0.921);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 2vw 3vw;
      box-shadow: 2px 3px 4px gray;
      position: relative;
      z-index: 100;
    }

    h1 {
      font-size: 1.8rem;
    }

    span {
      color: tomato;
    }

    nav ul {
      display: flex;
      gap: 25px;
      transition: all 0.3s ease;
    }

    nav ul li {
      list-style: none;
      font-size: 20px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.3s;
    }

    nav ul li:hover {
      color: tomato;
    }

    .search {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .search input {
      padding: 10px;
      border: 2px solid tomato;
      background-color: transparent;
      border-radius: 20px;
      color: tomato;
      font-size: 15px;
    }

    .search button {
      padding: 10px;
      background-color: tomato;
      color: white;
      border-radius: 15px;
      border: 2px solid white;
      font-size: 15px;
      font-weight: 550;
      cursor: pointer;
      transition: 0.3s;
    }

    .search button:hover {
      background-color: white;
      color: tomato;
      border: 2px solid tomato;
    }

    /* ====== Responsive Design ====== */
    @media (max-width: 768px) {
      nav {
        flex-wrap: wrap;
        padding: 15px 20px;
      }

      
      nav ul {
        display: none;
        flex-direction: column;
        width: 100%;
        background-color: rgba(250, 246, 240, 0.98);
        position: absolute;
        top: 70px;
        left: 0;
        text-align: center;
        padding: 15px 0;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      }

      nav ul.active {
        display: flex;
      }

      nav ul li {
        padding: 10px 0;
        font-size: 18px;
      }

      .search {
        width: 100%;
        justify-content: center;
        margin-top: 10px;
      }

      .menu-icon {
        display: block;
        font-size: 28px;
        cursor: pointer;
        color: tomato;
      }
    }

    /* Hide menu icon on large screens */
    .menu-icon {
      display: none;
    }
  </style>
</head>
<body>
  <nav>
    <h1><span>Saifi</span> -Coder</h1>

    <!-- Hamburger Icon -->
    <div class="menu-icon">&#9776;</div>

    <ul>
      <li>Home</li>
      <li>About</li>
      <li>Courses</li>
      <li>Blog</li>
      <li>Contact Us</li>
    </ul>

    <div class="search">
      <input type="text" placeholder="search anything">
      <button>Search</button>
    </div>
  </nav>

  <h2>
    <%= "Apna College ".toLowerCase() %>
  </h2>

  <script>
    // Select elements
    let button = document.querySelector("button");
    let allLis = document.querySelectorAll("li");
    let menuIcon = document.querySelector(".menu-icon");
    let navUl = document.querySelector("nav ul");

    // Change button text on click and double click
    button.addEventListener("click", () => {
      button.innerHTML = "Searching...";
    });
    button.addEventListener("dblclick", () => {
      button.innerHTML = "Search";
    });

    // Add click style effect to each li
    allLis.forEach((li) => {
      li.addEventListener("click", () => {
        allLis.forEach(item => {
          item.style.borderBottom = "none";
          item.style.color = "black";
        });
        li.style.borderBottom = "2px solid tomato";
        li.style.color = "tomato";

        // Auto-close menu after selecting (on mobile)
        if (window.innerWidth <= 768) {
          navUl.classList.remove("active");
        }
      });
    });

    // Toggle menu on mobile
    menuIcon.addEventListener("click", () => {
      navUl.classList.toggle("active");
    });
  </script>
</body>
</html>
