<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Student</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-gray-100 from-teal-300 to-blue-500 pb-10">

    <!-- NAVBAR -->
    <nav class="flex items-center justify-between px-10 py-4 bg-white shadow-xl fixed top-0 left-0 w-full z-50">
        <img class="w-16 h-16 object-contain scale-x-[-1]" 
            src="https://static.vecteezy.com/system/resources/previews/042/633/833/non_2x/mindful-masculinity-dynamic-black-symbol-for-male-student-achievement-in-logo-design-educational-edge-black-logo-design-for-ambitious-male-students-vector.jpg">

        <div class="flex items-center gap-5 text-xl font-semibold text-teal-700  px-4">
            <a href="/students" class="hover:text-teal-900">Home</a>
            <a href="/students" class="hover:text-teal-900">All Students</a>
            <a href="/students/create" class="hover:text-teal-900">Add Student</a>
        </div>
        <div class="flex items-center shadow-2xl shadow-teal-900 bg-transparent rounded-full">
            <input class="outline-none px-3 py-2 text-lg bg-teal-300 rounded-l-full" type="text" name="" id="" placeholder="Search">
            <button class="bg-teal-800 text-white px-3 py-2 rounded-r-full text-lg">Search</button>
        </div>
    </nav>

    <!-- MAIN WRAPPER (Margin added for navbar height) -->
    <div class="w-full flex justify-center mt-32 px-4">

        <!-- FORM CARD -->
        <div class="w-full max-w-xl bg-white rounded-2xl shadow-2xl p-8 border border-white/30">

            <h1 class="text-3xl font-bold text-center text-sky-900 drop-shadow mb-6">
                Add New Student
            </h1>

            <form action="/students" method="POST" class="flex flex-col gap-2">

                <div>
                    <label class="text-sky-600 font-semibold">Student Name</label>
                    <input name="student[name]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="text" required placeholder="Student Name">
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">Department</label>
                    <input name="student[department]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="text" required placeholder="Student Department">
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">Description</label>
                    <textarea name="student[description]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" rows="4" placeholder="Student Description"></textarea>
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">Semester</label>
                    <input name="student[semester]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="number" min="1" max="8" required placeholder="Student Semester">
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">Image URL</label>
                    <input name="student[image]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="text" placeholder="Student Image Link">
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">CGPA</label>
                    <input name="student[cgpa]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="number" step="0.01" min="0" max="4" required placeholder="Student CGPA">
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">College Name</label>
                    <input name="student[collegeName]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="text" required placeholder="Student College">
                </div>

                <div>
                    <label class="text-sky-600 font-semibold">Address</label>
                    <input name="student[location]" class="w-full px-3 py-2 mt-1 bg-sky-200 rounded-lg shadow focus:ring-2 focus:ring-teal-500 outline-none" type="text" required placeholder="Student Address">
                </div>

                <button class="mt-4 bg-teal-700 text-white py-2 rounded-xl text-lg font-semibold hover:bg-teal-800 hover:shadow-lg transition">
                    Create Student
                </button>

            </form>

        </div>

    </div>

</body>
</html>
