<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students Data</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <!-- FIXED NAVBAR -->
    <nav class="fixed top-0 left-0 w-full flex items-center justify-between 
                px-10 py-4 bg-white shadow-xl z-50">

        <!-- Logo -->
        <img class="w-16 h-16 object-contain scale-x-[-1] " 
             src="https://static.vecteezy.com/system/resources/previews/042/633/833/non_2x/mindful-masculinity-dynamic-black-symbol-for-male-student-achievement-in-logo-design-educational-edge-black-logo-design-for-ambitious-male-students-vector.jpg" 
             alt="">

        <!-- Links -->
        <div class="flex items-center gap-6 text-xl font-semibold text-teal-700  px-4">
            <a href="/students">Home</a>
            <a href="/students">All Students</a>
            <a href="/students/create">Add Student</a>
        </div>
        <div class="flex items-center shadow-2xl shadow-teal-900 bg-transparent rounded-full">
            <input class="outline-none px-3 py-2 text-lg bg-teal-300 rounded-l-full" type="text" name="" id="" placeholder="Search">
            <button class="bg-teal-800 text-white px-3 py-2 rounded-r-full text-lg">Search</button>
        </div>
    </nav>

    <!-- PAGE CONTENT STARTS BELOW NAVBAR -->
    <div class="pt-32">

        <h1 class="text-3xl font-bold text-center mb-10 text-orange-600">
            Students Data
        </h1>

        <!-- Grid Layout -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 
                    gap-4 p-10">

            <% allStudents.forEach(student => { %>

            <div class="bg-white shadow-lg rounded-2xl p-5 text-center 
                        hover:shadow-xl transition-all duration-300">

                <!-- Profile Image -->
                <div class="w-24 h-24 mx-auto rounded-full overflow-hidden 
                            border-4 border-white shadow">
                    <img src="<%= student.image %>" 
                         alt="Profile"
                         class="w-full h-full object-cover">
                </div>

                <!-- Name -->
                <h2 class="text-lg font-semibold text-gray-900 mt-3">
                    <%= student.name %>
                </h2>

                <!-- University -->
                <p class="text-sm text-gray-500">
                    <span class="font-semibold">University:</span> 
                    <%= student.collegeName %>
                </p>

                <!-- Button -->
                <a href="/students/<%= student._id %>"
                   class="mt-4 block w-full bg-teal-500 hover:bg-teal-600 
                          text-white font-medium py-2 rounded-full transition">
                    Detailed View
                </a>

            </div>

            <% }) %>

        </div>

    </div>
</body>
</html>
